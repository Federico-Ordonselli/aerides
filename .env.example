# Copy to .env (never commit .env) and adjust.
# docker compose reads .env automatically.

# PostgreSQL
POSTGRES_DB=raidboard
POSTGRES_USER=raidboard
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Secret used to sign access tokens (HS256): at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Send the refresh cookie only over HTTPS. Browsers accept Secure cookies on http://localhost too.
REFRESH_COOKIE_SECURE=true

# Origins allowed to call the API directly (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# RAWG video game database: free key from https://rawg.io/apidocs
# Without it the app works, but game search answers "unavailable"
RAWG_API_KEY=

# Brute-force protection on /api/auth/login and /api/auth/refresh (attempts per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_IP_AND_EMAIL=5
RATE_LIMIT_LOGIN_PER_IP=20
# Per account, whatever the IP: attempts every 15 minutes
RATE_LIMIT_LOGIN_PER_EMAIL=20
RATE_LIMIT_REFRESH_PER_IP=20

# Regex of the reverse proxies allowed to set X-Forwarded-For (default: any private-network address).
# In production set it to the real proxy only, e.g. 10\.0\.1\.\d+
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Template: BACKEND_URL and BACKEND_HOST are filled in when the container starts (see Dockerfile).
    # docker compose: http://backend:8080 and the browser's Host. Azure Container Apps: the backend app's
    # internal address, and its own host name, because the Container Apps ingress routes by Host header.

    # API calls go to the backend container: the browser sees a single origin, so no CORS is needed
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host ${BACKEND_HOST};
        # Overwrite, don't append: nginx is the entry point, so the client must not be able to
        # inject its own X-Forwarded-For and pick a new IP (and a new rate-limit bucket) each request
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket (STOMP): same proxy, plus the headers that switch the connection to the WebSocket protocol
    location = /ws {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Open sockets are idle most of the time: don't let nginx close them after the default 60s
        proxy_read_timeout 1h;
    }

    # Hashed bundles never change: cache them for a long time
    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: unknown paths are Angular routes, so serve index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}

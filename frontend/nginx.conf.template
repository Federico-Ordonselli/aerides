server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Template: BACKEND_URL, BACKEND_HOST, FORWARDED_FOR and FORWARDED_PROTO are filled in when the container
    # starts (see Dockerfile).
    # docker compose: http://backend:8080 and the browser's Host. Azure Container Apps: the backend app's
    # internal address, and its own host name, because the Container Apps ingress routes by Host header.

    # API calls go to the backend container: the browser sees a single origin, so no CORS is needed
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host ${BACKEND_HOST};
        # Client IP for the rate limiter. docker compose (FORWARDED_FOR=$remote_addr): nginx is the entry point,
        # so it overwrites the header and a client can't inject its own IP to get a new rate-limit bucket.
        # Behind a managed ingress ($proxy_add_x_forwarded_for): nginx appends to the header written by the
        # ingress, and the backend takes the right-most address that isn't a trusted private proxy.
        proxy_set_header X-Forwarded-For ${FORWARDED_FOR};
        proxy_set_header X-Forwarded-Proto ${FORWARDED_PROTO};
    }

    # WebSocket (STOMP): same proxy, plus the headers that switch the connection to the WebSocket protocol
    location = /ws {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Forwarded-For ${FORWARDED_FOR};
        proxy_set_header X-Forwarded-Proto ${FORWARDED_PROTO};
        # Open sockets are idle most of the time: don't let nginx close them after the default 60s
        proxy_read_timeout 1h;
    }

    # Hashed bundles never change: cache them for a long time
    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: unknown paths are Angular routes, so serve index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
